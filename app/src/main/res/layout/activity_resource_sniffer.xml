<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="资源嗅探" />

    <TextView
        android:textSize="12sp"
        android:textColor="@color/gray"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="输入网址，自动嗅探页面中的视频、音频、图片等资源。点击资源可下载或复制链接。" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/et_sniff_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入网址"
            android:singleLine="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_sniff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="嗅探"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="筛选: " />

        <Button
            android:id="@+id/btn_filter_all"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="全部"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_filter_video"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="视频"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_filter_audio"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="音频"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_filter_image"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="图片"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_filter_other"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="其他"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_sniff_count"
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="找到 0 个资源" />

        <Button
            android:id="@+id/btn_clear_sniffed"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="清空"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lv_resources"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/light_gray"
        android:dividerHeight="1dp" />
</LinearLayout>